{
  "name": "@perpparrot/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "backtest:public": "bun src/backtest/fetch-public.ts",
    "backtest:explore:active": "bun src/backtest/explore-active-cohort.ts",
    "typecheck": "tsc --noEmit",
    "ingest:once": "bun --no-env-file src/ingest/loop/once.ts",
    "ingest:worker": "bun --no-env-file src/ingest/loop/server.ts",
    "test:ingest": "bun --no-env-file test test/ingest-history.test.ts test/ingest-score-input.test.ts test/ingest-loop.test.ts test/ingest-loop-collect.test.ts test/ingest-loop-export.test.ts test/ingest-loop-import.test.ts test/ingest-loop-release.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
