{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate-curation-frame",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "asOfMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "kind": {
            "enum": [
              "TRADER",
              "HYPERCORE_VAULT",
              "ERC4626_HYPERCORE"
            ]
          },
          "clones": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "historyDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "oosWindows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "oosSharpe": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "oosSortino": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "oosMaxDrawdown": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "crossWindowStability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "survivorshipQuality": {
                "enum": [
                  "CURRENT_SNAPSHOT",
                  "POINT_IN_TIME",
                  "UNKNOWN"
                ]
              },
              "medianHoldMinutes": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "averageLeverage": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxDrawdown": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timeInMarket": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "makerShare": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionCoverage": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionFit": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "concentration": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "liquidationDistance": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "btcBeta": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pnlConsistency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "isSharpe": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "isSortino": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "isCalmar": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lookbackDays": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "scoreFlags": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z-]{0,31}$"
                }
              },
              "cloneCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "historyDays",
              "oosWindows",
              "oosSharpe",
              "oosSortino",
              "oosMaxDrawdown",
              "crossWindowStability",
              "survivorshipQuality",
              "medianHoldMinutes",
              "averageLeverage",
              "maxDrawdown",
              "timeInMarket",
              "makerShare",
              "executionCoverage",
              "executionFit",
              "concentration",
              "liquidationDistance",
              "btcBeta",
              "pnlConsistency",
              "isSharpe",
              "isSortino",
              "isCalmar",
              "lookbackDays",
              "scoreFlags",
              "cloneCount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "candidate",
          "kind",
          "metrics",
          "clones"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 25
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "b": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "correlation": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "currentExposureOverlap": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "linkedSource": {
            "type": "boolean"
          }
        },
        "required": [
          "a",
          "b",
          "correlation",
          "currentExposureOverlap",
          "linkedSource"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 300
    }
  },
  "required": [
    "schemaVersion",
    "snapshotHash",
    "policyHash",
    "asOfMs",
    "expiresAtMs",
    "candidates",
    "pairs"
  ],
  "additionalProperties": false
}
