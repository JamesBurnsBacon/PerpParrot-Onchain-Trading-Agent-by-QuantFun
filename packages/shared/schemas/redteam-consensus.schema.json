{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "redteam-consensus",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "draftHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "promptHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "modelConfigHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "quorum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rebuildScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "portfolioRisk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "penalties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 39
          },
          "multiplier": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "excludeScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "candidate",
          "multiplier",
          "excludeScore"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 15
    }
  },
  "required": [
    "schemaVersion",
    "snapshotHash",
    "policyHash",
    "draftHash",
    "promptHash",
    "modelConfigHash",
    "quorum",
    "rebuildScore",
    "portfolioRisk",
    "penalties"
  ],
  "additionalProperties": false
}
