{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bucket-policy",
  "type": "object",
  "properties": {
    "bucket": {
      "enum": [
        "CONSERVATIVE",
        "BALANCED",
        "AGGRESSIVE"
      ]
    },
    "mode": {
      "enum": [
        "LIVE",
        "SIMULATION"
      ]
    },
    "capitalUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minOrderUsd": {
      "const": 10
    },
    "minExecutableTargets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "maxSourceWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maxGrossLeverage": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cashBuffer": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maxPairCorrelation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maxExposureOverlap": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minHistoryDays": {
      "type": "number",
      "minimum": 30
    },
    "maxFrameAgeMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "minExecutionFit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "riskRejectThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "riskWatchThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "minConfidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "redTeamRebuildThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "redTeamExcludeThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "bucket",
    "mode",
    "capitalUsd",
    "minOrderUsd",
    "minExecutableTargets",
    "maxSourceWeight",
    "maxGrossLeverage",
    "cashBuffer",
    "maxPairCorrelation",
    "maxExposureOverlap",
    "minHistoryDays",
    "maxFrameAgeMs",
    "minExecutionFit",
    "riskRejectThreshold",
    "riskWatchThreshold",
    "minConfidence",
    "redTeamRebuildThreshold",
    "redTeamExcludeThreshold"
  ],
  "additionalProperties": false
}
