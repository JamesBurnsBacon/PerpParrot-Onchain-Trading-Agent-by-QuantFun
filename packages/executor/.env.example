# Local dev server (bun run dev). Copy to .env.
PORT=8787
# The backend that serves each run's targets (bun run dev in packages/backend). On Vercel the
# backend service binding injects BACKEND_URL (vercel.json).
BACKEND_URL=http://localhost:8788
# Must match the backend's FROZEN_CONFIGURATION_HASH and the frozen configuration's account.
FROZEN_CONFIGURATION_HASH=0x088fe80aef2b0d1d58a2e483073105c141fcf4d13ef80f934dfe811c81e6e1dd
HL_ACCOUNT=0x010461c14e146ac35fe42271bdc1134ee31c703a
# Dry run unless explicitly "false" (never on Vercel: live trading needs one long-running process).
# DRY_RUN=false
# Dry run only: plan as if our account held this much (an unfunded account plans no orders).
# DRY_RUN_EQUITY_USD=10000
# HL_API_WALLET_KEY=0x…
