# Local dev server (bun run dev). Copy to .env.
PORT=8787
# false only for `cre workflow simulate` reports; refused when NODE_ENV=production.
VERIFY_REPORTS=false
# Org-derived workflow owner (cre whoami -v → derivedWorkflowOwners; should match the
# Organization address in the CRE platform UI).
WORKFLOW_OWNER=0xc5feb3cf878c9ba42a776e9edf62a4558ab08b85
ETH_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Must match the mirror workflow's config.frozenSetHash.
FROZEN_SET_HASH=0xf169c1cec9f53dbc068305c9147d11410e7b5ced85363fe994ad191e411e4a32
MAX_REPORT_AGE_SECONDS=300
