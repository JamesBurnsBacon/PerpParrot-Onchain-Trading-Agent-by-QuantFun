# Optional. Unset, the dashboard reads the services on its own origin (/api/backend and
# /api/executor, routed by vercel.json; proxied to localhost:8788/8787 under `next dev`).
# Set these only to read services elsewhere. Baked in at build time: redeploy after changing.
# NEXT_PUBLIC_BACKEND_URL=https://<host>/api/backend
# NEXT_PUBLIC_EXECUTOR_URL=https://<host>/api/executor
