{
  "name": "perpparrot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/cre-workflows/review-spike/tsconfig.json && tsc --noEmit -p packages/cre-workflows/mirror-spike/tsconfig.json",
    "test:cre": "bun test packages/cre-workflows/tests/*.test.ts",
    "compile:review-spike": "bun packages/cre-workflows/node_modules/@chainlink/cre-sdk/bin/cre-compile.ts packages/cre-workflows/review-spike/main.ts work/review-spike.wasm",
    "paper:smoke": "node tests/paper_smoke.ts",
    "compile:mirror-spike": "bun packages/cre-workflows/node_modules/@chainlink/cre-sdk/bin/cre-compile.ts packages/cre-workflows/mirror-spike/main.ts work/mirror-spike.wasm"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@ethereumjs/util": "10.1.2",
    "@ethereumjs/vm": "10.1.2",
    "@types/node": "^24.0.0",
    "solc": "0.8.30",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "ajv": "^8.17.1",
    "viem": "2.57.3",
    "zod": "3.25.76"
  }
}
