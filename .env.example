# Local scripts and the backend's selection pipeline (packages/backend/src/pipeline) call the model.
# Never commit .env.
OPENAI_API_KEY=
# Backend pipeline (optional): REVIEW_MODEL (default gpt-4.1-mini-2025-04-14); REVIEW_GATE=strict to
# activate only the review core's VALID manifests (default basic: docs/ops/DEPLOY.md "Selection pipeline").
# Hyperliquid read routing (optional, docs/ops/DEPLOY.md "NOWNodes failover"): NOWNODES_API_KEY enables it,
# INFO_ROUTING=official (default, today's behavior) | overflow (NOWNodes only when the official API fails)
# | split (INFO_SPLIT_PERCENT, default 25, of NOWNodes-capable reads go to NOWNodes first);
# INFO_SHADOW_PERCENT=N compares N% of official clearinghouseState reads with NOWNodes in the background.
NOWNODES_API_KEY=
