{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "services": {
    "backend": {
      "root": "packages/backend",
      "framework": "bun",
      "entrypoint": "src/server.ts",
      "installCommand": "bun install --frozen-lockfile --production --omit=peer && { cd ../shared 2>/dev/null || cd ../../shared; } && bun install --frozen-lockfile --production",
      "devCommand": "bun run dev",
      "functions": {
        "src/server.ts": { "maxDuration": 800, "includeFiles": "packages/{backend/{fixtures,frozen,node_modules/**/@noble/hashes},shared/node_modules}/**" }
      }
    },
    "executor": {
      "root": "packages/executor",
      "framework": "bun",
      "entrypoint": "src/server.ts",
      "installCommand": "bun install --frozen-lockfile --production --omit=peer",
      "devCommand": "bun run dev",
      "functions": {
        "src/server.ts": { "includeFiles": "packages/executor/node_modules/**/@noble/hashes/**" }
      },
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    },
    "dashboard": {
      "root": "packages/dashboard",
      "framework": "nextjs",
      "installCommand": "bun install --frozen-lockfile",
      "buildCommand": "bun run build"
    }
  },
  "rewrites": [
    { "source": "/api/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/executor/(.*)", "destination": { "service": "executor" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ],
  "crons": [
    { "path": "/api/backend/cron/snapshot", "schedule": "9,19,29,39,49,59 * * * *" },
    { "path": "/api/executor/cron/run", "schedule": "0,10,20,30,40,50 * * * *" },
    { "path": "/api/executor/cron/watchdog", "schedule": "*/5 * * * *" },
    { "path": "/api/backend/cron/pipeline/scan", "schedule": "15 0,12 * * *" },
    { "path": "/api/backend/cron/pipeline/refresh", "schedule": "2,7,12,17,22,27,32,37,42,47,52,57 * * * *" },
    { "path": "/api/backend/cron/pipeline/select", "schedule": "4,14,24,34,44,54 * * * *" },
    { "path": "/api/backend/cron/pipeline/roster", "schedule": "6,16,26,36,46,56 * * * *" }
  ]
}
