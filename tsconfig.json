{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
