{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/backend/review/**/*.ts",
    "tests/**/*.ts"
  ]
}
